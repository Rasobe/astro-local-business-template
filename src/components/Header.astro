---
import { business } from "@config/business";
import { buildWhatsAppLink } from "@/lib/whatsapp";

const links = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#galeria", label: "Trabajos" },
  { href: "/#opiniones", label: "Opiniones" },
  { href: "/#visitanos", label: "Horario" },
];
const wa = business.whatsapp ? buildWhatsAppLink(business.whatsapp, business.whatsappMessage) : null;
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__brand">{business.name}</a>
    <nav aria-label="Principal">
      <ul class="header__nav">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    {wa && <a class="btn header__cta" href={wa} rel="noopener" target="_blank">Pedir cita</a>}
  </div>
</header>

<style lang="scss">
  @use "styles/breakpoints" as *;
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--c-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 4rem;
  }
  .header__brand {
    font-family: var(--font-display), var(--font-display-fallback);
    text-decoration: none;
    font-size: 1.15rem;
  }
  .header__nav {
    display: none;
    list-style: none;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    font-family: var(--font-body), var(--font-body-fallback);
    font-weight: 600;
    a {
      text-decoration: none;
      &:hover {
        color: var(--c-muted);
      }
    }
    @media (min-width: $bp-md) {
      display: flex;
    }
  }
  .header__cta {
    display: none;
    @media (min-width: $bp-md) {
      display: inline-flex;
    }
  }
</style>
