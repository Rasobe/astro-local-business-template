---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { business } from "@config/business";

// Mete las fotos en src/assets/gallery/ (jpg/png/webp). Se ordenan por nombre: 01-*.jpg, 02-*.jpg…
// Astro las convierte a WebP/AVIF y genera srcset automáticamente.
const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/gallery/*.{jpg,jpeg,png,webp}", {
  eager: true,
});
const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod], i) => ({
    src: mod.default,
    // El nombre del archivo sirve de alt: "03-fachada-del-local.jpg" → "Fachada del local"
    alt:
      path
        .split("/")
        .pop()!
        .replace(/\.\w+$/, "")
        .replace(/^\d+[-_]?/, "")
        .replace(/[-_]+/g, " ")
        .replace(/^\w/, (c) => c.toUpperCase()) || `Trabajo ${i + 1} de ${business.name}`,
  }));
---

{
  photos.length > 0 && (
    <section class="section" id="galeria">
      <div class="container">
        <p class="eyebrow">Trabajos</p>
        <h2>Nuestro trabajo</h2>
        <ul class="gallery">
          {photos.map((p, i) => (
            <li class={i % 5 === 0 ? "gallery__item gallery__item--tall" : "gallery__item"}>
              <Image src={p.src} alt={p.alt} widths={[320, 480, 720]} sizes="(min-width: 48rem) 33vw, 50vw" />
            </li>
          ))}
        </ul>
        {business.social.instagram && (
          <p class="gallery__more">
            <a class="btn btn--ghost" href={business.social.instagram} rel="noopener" target="_blank">
              Ver más en Instagram
            </a>
          </p>
        )}
      </div>
    </section>
  )
}

<style lang="scss">
  @use "styles/breakpoints" as *;
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 11rem;
    grid-auto-flow: dense; // evita huecos con las celdas altas
    gap: var(--space-1);
    @media (min-width: $bp-md) {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 15rem;
    }
  }
  .gallery__item {
    overflow: hidden;
    border-radius: var(--radius);
    &--tall {
      grid-row: span 2;
    }
    :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
  .gallery__more {
    margin-top: var(--space-3);
    text-align: center;
  }
</style>
