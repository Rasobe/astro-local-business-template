---
import { Font } from "astro:assets";
import { business, siteUrl } from "@config/business";
import Seo from "@/components/Seo.astro";
import JsonLd from "@/components/JsonLd.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppCta from "@/components/WhatsAppCta.astro";
import { localBusinessData, websiteData } from "@/lib/structured-data";
import "@/styles/global.scss";

interface Props {
  title?: string;
  description?: string;
  absoluteTitle?: boolean;
  noindex?: boolean;
  /** Solo la home lleva el JSON-LD del negocio */
  withBusinessSchema?: boolean;
}
const { withBusinessSchema = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang={business.seo.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={business.themeColor} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-ui" />
    <Font cssVariable="--font-body" preload />

    <Seo {...seo} />
    {
      withBusinessSchema && (
        <>
          <JsonLd data={localBusinessData(business, siteUrl)} />
          <JsonLd data={websiteData(business, siteUrl)} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppCta />
  </body>
</html>
